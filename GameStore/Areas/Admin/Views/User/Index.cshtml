@model List<GameStore.Models.DB.User>

@{
    ViewData["Title"] = "จัดการผู้ใช้";
}

<p class="section-title">👥 จัดการผู้ใช้</p>

<!-- สถิติ -->
<div class="row mb-4">
    <div class="col-md-3 mb-3">
        <div class="stat-card text-center">
            <p class="text-secondary mb-1" style="font-size: 12px;">ทั้งหมด</p>
            <p class="fw-bold mb-0" style="font-size: 28px; color: #e94560;">@Model.Count</p>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="stat-card text-center">
            <p class="text-secondary mb-1" style="font-size: 12px;">Customer</p>
            <p class="fw-bold mb-0" style="font-size: 28px; color: #27ae60;">@Model.Count(u => u.RoleId == 4)</p>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="stat-card text-center">
            <p class="text-secondary mb-1" style="font-size: 12px;">Publisher</p>
            <p class="fw-bold mb-0" style="font-size: 28px; color: #3498db;">@Model.Count(u => u.RoleId == 3)</p>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="stat-card text-center">
            <p class="text-secondary mb-1" style="font-size: 12px;">ถูกระงับ</p>
            <p class="fw-bold mb-0" style="font-size: 28px; color: #e74c3c;">@Model.Count(u => u.IsActive == false)</p>
        </div>
    </div>
</div>

<!-- ตาราง -->
<div class="rounded-3" style="background: #16213e; border: 1px solid #e9456022; overflow: hidden;">
    <table class="table table-dark mb-0 table-dark-custom">
        <thead>
            <tr>
                <th>ID</th>
                <th>ผู้ใช้</th>
                <th>อีเมล</th>
                <th>Role</th>
                <th>สถานะ</th>
                <th>วันที่สมัคร</th>
                <th>จัดการ</th>
            </tr>
        </thead>
        <tbody>
            @{ int i = 1; }
            @foreach (var user in Model)
            {
                <tr>
                    <td class="text-secondary">#@(i++)</td>
                    <td class="fw-bold text-light">@(user.DisplayName ?? user.Username) <span class="text-secondary" style="font-size: 12px;">(@user.Username)</span></td>
                    <td class="text-secondary">@user.Email</td>
                    <td>
                        @switch (user.RoleId)
                        {
                            case 1:
                                <span class="badge" style="background: #e94560;">Super Admin</span>
                                break;
                            case 2:
                                <span class="badge" style="background: #9b59b6;">Admin</span>
                                break;
                            case 3:
                                <span class="badge" style="background: #3498db;">Publisher</span>
                                break;
                            default:
                                <span class="badge" style="background: #27ae60;">Customer</span>
                                break;
                        }
                    </td>
                    <td>
                        @if (user.IsActive == true)
                        {
                            <span class="badge badge-approved">ใช้งาน</span>
                        }
                        else
                        {
                            <span class="badge badge-rejected">ระงับ</span>
                        }
                    </td>
                    <td class="text-secondary" style="font-size: 13px;">@(user.CreatedAt?.ToString("dd MMM yyyy") ?? "-")</td>
                    <td>
                        <div class="d-flex gap-1">
                            <a asp-route-UID="@user.UserId" asp-action="Edit" asp-controller="User" class="btn btn-sm" style="border: 1px solid #3498db; color: #3498db;">Edit</a>
                            @{
                                var deleteUrl = Url.Action("Delete", "User", new { area = "Admin", UID = user.UserId });
                                var deleteName = user.DisplayName ?? user.Username;
                            }
                            <form action="@deleteUrl" method="post" class="d-inline" onsubmit="return confirm('ลบผู้ใช้ &quot;@deleteName&quot; ใช่หรือไม่?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm" style="border: 1px solid #e74c3c; color: #e74c3c;">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
