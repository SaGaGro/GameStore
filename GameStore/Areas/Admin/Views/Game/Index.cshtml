@model List<GameStore.Models.DB.Game>

@{
    ViewData["Title"] = "อนุมัติเกม";
}

<p class="section-title">🎮 อนุมัติเกม</p>

<!-- รออนุมัติ -->
<h6 class="text-accent mb-3">⏳ รออนุมัติ (@Model.Count(g => g.IsApproved != true))</h6>

@foreach (var game in Model.Where(g => g.IsApproved != true))
{
    <div class="rounded-3 p-3 mb-3 d-flex align-items-center" style="background: #16213e; border: 1px solid #f39c1233;">
        <img src="@game.CoverImage" alt="@game.Title" class="rounded me-3" style="width: 120px; height: 70px; object-fit: cover;" />
        <div class="flex-fill">
            <h6 class="fw-bold text-light mb-1">@game.Title</h6>
            <span class="text-secondary" style="font-size: 13px;">@game.Genre · ฿@game.BasePrice.ToString("N0") · ส่งเมื่อ @(game.CreatedAt?.ToString("dd MMM yyyy") ?? "-")</span>
        </div>
        @{ var gameTitle = game.Title; }
        <div class="d-flex gap-2">
            <form asp-action="Approve" asp-controller="Game" method="post" class="d-inline"
                  data-confirm="อนุมัติเกม &quot;@gameTitle&quot; ใช่หรือไม่?">
                <input type="hidden" name="id" value="@game.GameId" />
                <button type="submit" class="btn btn-sm fw-bold" style="background: #27ae60; color: #fff;">✓ อนุมัติ</button>
            </form>
            <form asp-action="Reject" asp-controller="Game" method="post" class="d-inline"
                  data-confirm="ปฏิเสธเกม &quot;@gameTitle&quot; ใช่หรือไม่?">
                <input type="hidden" name="id" value="@game.GameId" />
                <button type="submit" class="btn btn-sm fw-bold" style="background: #e74c3c; color: #fff;">✕ ปฏิเสธ</button>
            </form>
        </div>
    </div>
}

<!-- อนุมัติแล้ว -->
<h6 class="text-accent mb-3 mt-4">✅ อนุมัติแล้ว (@Model.Count(g => g.IsApproved == true))</h6>

<div class="rounded-3" style="background: #16213e; border: 1px solid #e9456022; overflow: hidden;">
    <table class="table table-dark mb-0 table-dark-custom">
        <thead>
            <tr>
                <th>เกม</th>
                <th>หมวดหมู่</th>
                <th>ราคา</th>
                <th>สถานะ</th>
                <th>จัดการ</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var game in Model.Where(g => g.IsApproved == true))
            {
                <tr>
                    <td>
                        <div class="d-flex align-items-center">
                            <img src="@game.CoverImage" class="rounded me-2" style="width: 50px; height: 30px; object-fit: cover;" />
                            <span class="fw-bold text-light">@game.Title</span>
                        </div>
                    </td>
                    <td class="text-secondary">@game.Genre</td>
                    <td style="color: #e94560;">฿@game.BasePrice.ToString("N0")</td>
                    <td><span class="badge badge-approved">อนุมัติแล้ว</span></td>
                    <td>
                        @{ var approvedGameTitle = game.Title; }
                        <form asp-action="Reject" asp-controller="Game" method="post" class="d-inline"
                              data-confirm="ระงับเกม &quot;@approvedGameTitle&quot; ใช่หรือไม่?">
                            <input type="hidden" name="id" value="@game.GameId" />
                            <button type="submit" class="btn btn-sm" style="border: 1px solid #e74c3c; color: #e74c3c;">ระงับ</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
