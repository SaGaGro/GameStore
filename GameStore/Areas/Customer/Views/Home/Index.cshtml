@model List<GameStore.Models.DB.Game>

@{
    ViewData["Title"] = "หน้าแรก";
}

<!-- Banner -->
<div class="rounded-3 mb-4 p-5 text-center" style="background: linear-gradient(135deg, #0f3460, #e94560); border-radius: 12px;">
    <h1 class="fw-bold mb-2">🎮 ยินดีต้อนรับสู่ GameStore</h1>
    <p class="mb-3" style="color: #ddd;">ค้นหาเกมที่ใช่สำหรับคุณ ลดราคาสูงสุด 50%!</p>
    <a class="btn btn-lg fw-bold" style="background: #fff; color: #e94560;" asp-area="Customer" asp-controller="Game" asp-action="Index">เข้าร้านค้า</a>
</div>

<!-- เกมยอดนิยม -->
<p class="section-title">🔥 เกมยอดนิยม</p>
<div class="row mb-5">
    @foreach (var game in Model.OrderByDescending(g => g.SoldCount).Take(4))
    {
        var isEarlyBird = game.ReleaseDate > DateTime.Now && game.DiscountPercent > 0;
        <div class="col-md-3 mb-3">
            <a asp-area="Customer" asp-controller="Game" asp-action="Detail" asp-route-id="@game.GameId" style="text-decoration:none;">
            <div class="game-card">
                <img src="@game.CoverImage" alt="@game.Title" />
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <span class="game-genre">@game.Genre</span>
                        @if (isEarlyBird)
                        {
                            <span class="badge-earlybird">⚡ Pre-order -@game.DiscountPercent%</span>
                        }
                        else if (game.DiscountPercent > 0)
                        {
                            <span class="badge-sale">-@game.DiscountPercent%</span>
                        }
                        else if (game.IsFree == true)
                        {
                            <span class="badge-free">ฟรี</span>
                        }
                    </div>
                    <p class="game-title mt-1">@game.Title</p>
                    <div>
                        @if (game.IsFree == true)
                        {
                            <span class="game-price">ฟรี</span>
                        }
                        else if (game.DiscountPercent > 0)
                        {
                            var discounted = game.BasePrice - (game.BasePrice * game.DiscountPercent.Value / 100);
                            <span class="game-price-old">฿@game.BasePrice.ToString("N0")</span>
                            <span class="game-price">฿@discounted.ToString("N0")</span>
                        }
                        else
                        {
                            <span class="game-price">฿@game.BasePrice.ToString("N0")</span>
                        }
                    </div>
                    <div class="mt-1" style="color: #f1c40f; font-size: 12px;">
                        ⭐ @(game.Rating?.ToString("F1") ?? "0.0") /5 · ขายแล้ว @(game.SoldCount?.ToString("N0") ?? "0") ชุด
                    </div>
                </div>
            </div>
            </a>
        </div>
    }
</div>

<!-- เกมฟรี -->
<p class="section-title">🎁 เกมฟรีช่วงนี้</p>
<div class="row mb-5">
    @foreach (var game in Model.Where(g => g.IsFree == true))
    {
        <div class="col-md-3 mb-3">
            <div class="game-card">
                <img src="@game.CoverImage" alt="@game.Title" />
                <div class="card-body">
                    <span class="game-genre">@game.Genre</span>
                    <span class="badge-free ms-2">ฟรี</span>
                    <p class="game-title mt-1">@game.Title</p>
                    <span class="game-price">ฟรี</span>
                    <div class="mt-1" style="color: #f1c40f; font-size: 12px;">
                        ⭐ @(game.Rating?.ToString("F1") ?? "0.0") /5
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Early Bird / Pre-order -->
@{
    var earlyBirdGames = Model.Where(g => g.ReleaseDate > DateTime.Now && g.DiscountPercent > 0).ToList();
}
@if (earlyBirdGames.Any())
{
    <p class="section-title">⚡ Pre-order Early Bird</p>
    <div class="row mb-5">
        @foreach (var game in earlyBirdGames)
        {
            var daysLeft = (game.ReleaseDate!.Value - DateTime.Now).Days;
            var discounted = game.BasePrice - (game.BasePrice * game.DiscountPercent!.Value / 100);
            <div class="col-md-3 mb-3">
                <a asp-area="Customer" asp-controller="Game" asp-action="Detail" asp-route-id="@game.GameId" style="text-decoration:none;">
                <div class="game-card" style="border-color: #f39c1255;">
                    <img src="@game.CoverImage" alt="@game.Title" />
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <span class="game-genre">@game.Genre</span>
                            <span class="badge-earlybird">⚡ -@game.DiscountPercent%</span>
                        </div>
                        <p class="game-title mt-1">@game.Title</p>
                        <div>
                            <span class="game-price-old">฿@game.BasePrice.ToString("N0")</span>
                            <span class="game-price">฿@discounted.ToString("N0")</span>
                        </div>
                        <div class="mt-1" style="font-size: 11px; color: #f39c12;">
                            🗓️ วางจำหน่ายใน @daysLeft วัน · @game.ReleaseDate.Value.ToString("dd MMM yyyy")
                        </div>
                    </div>
                </div>
                </a>
            </div>
        }
    </div>
}

<!-- เกมลดราคา -->
<p class="section-title">💰 เกมลดราคา</p>
<div class="row mb-5">
    @foreach (var game in Model.Where(g => g.DiscountPercent > 0))
    {
        <div class="col-md-3 mb-3">
            <div class="game-card">
                <img src="@game.CoverImage" alt="@game.Title" />
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <span class="game-genre">@game.Genre</span>
                        <span class="badge-sale">-@game.DiscountPercent%</span>
                    </div>
                    <p class="game-title mt-1">@game.Title</p>
                    <div>
                        @{
                            var disc = game.BasePrice - (game.BasePrice * game.DiscountPercent.Value / 100);
                        }
                        <span class="game-price-old">฿@game.BasePrice.ToString("N0")</span>
                        <span class="game-price">฿@disc.ToString("N0")</span>
                    </div>
                    <div class="mt-1" style="color: #f1c40f; font-size: 12px;">
                        ⭐ @(game.Rating?.ToString("F1") ?? "0.0") /5
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- เกมทดลองเล่น -->
<p class="section-title">🕹️ ทดลองเล่นฟรี</p>
<div class="row mb-5">
    @foreach (var game in Model.Where(g => g.HasTrial == true))
    {
        <div class="col-md-3 mb-3">
            <div class="game-card">
                <img src="@game.CoverImage" alt="@game.Title" />
                <div class="card-body">
                    <span class="game-genre">@game.Genre</span>
                    <p class="game-title mt-1">@game.Title</p>
                    <span class="game-price">฿@game.BasePrice.ToString("N0")</span>
                    <div class="mt-1" style="font-size: 12px; color: #27ae60;">
                        🎮 ทดลองเล่นฟรี @game.TrialHours ชม.
                    </div>
                </div>
            </div>
        </div>
    }
</div>
