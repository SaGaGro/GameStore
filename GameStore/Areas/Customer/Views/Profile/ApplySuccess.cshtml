@{
    ViewData["Title"] = "ส่งคำขอสำเร็จ";
}

<div class="text-center py-5">
    <div class="rounded-3 p-5 mx-auto" style="background: #16213e; border: 1px solid #e9456022; max-width: 500px;">
        <p style="font-size: 64px;">📩</p>
        <h3 class="fw-bold mb-2">ส่งคำขอสำเร็จ!</h3>
        <p class="text-secondary mb-1">คำขอสมัครเป็นผู้ลงเกมถูกส่งเรียบร้อยแล้ว</p>
        <p class="text-secondary mb-4">Admin จะตรวจสอบและแจ้งผลภายใน 1-3 วันทำการ</p>

        <div class="rounded-3 p-3 mb-4 mx-auto" style="background: #0f3460; max-width: 300px;">
            <p class="mb-1" style="font-size: 13px; color: #f39c12;">📌 สถานะ</p>
            <p class="fw-bold mb-0" style="font-size: 20px; color: #f39c12;">รอตรวจสอบ</p>
        </div>

        <a asp-action="Index" class="btn fw-bold" style="background: #e94560; color: #fff;">
            👤 กลับหน้าโปรไฟล์
        </a>
    </div>
</div>