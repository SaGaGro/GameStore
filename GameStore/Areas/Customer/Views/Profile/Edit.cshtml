@model GameStore.ViewModels.PublisherRequestViewModel

@{
    ViewData["Title"] = "สมัครเป็นผู้ลงเกม";
}

<a asp-action="Index" class="btn btn-sm mb-3" style="border: 1px solid #e94560; color: #e94560;">
    ← กลับโปรไฟล์
</a>

<p class="section-title">🎮 สมัครเป็นผู้ลงเกม (Publisher)</p>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="rounded-3 p-4" style="background: #16213e; border: 1px solid #e9456022;">

            <div class="rounded-3 p-3 mb-4" style="background: #0f3460; font-size: 13px; color: #aaa;">
                <span class="fw-bold text-light">📌 หมายเหตุ:</span>
                หลังจากส่งคำขอ Admin จะตรวจสอบข้อมูลและแจ้งผลภายใน 1-3 วันทำการ
                เมื่อได้รับอนุมัติ คุณจะสามารถลงเกมขายในระบบได้
            </div>

            <form asp-action="ApplyPublisher" method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <label asp-for="CompanyName" class="form-label text-light">ชื่อค่ายเกม / สตูดิโอ</label>
                    <input asp-for="CompanyName" class="form-control"
                        style="background: #0f3460; border: 1px solid #e9456055; color: #fff;" placeholder="เช่น Awesome Studio" />
                    <span asp-validation-for="CompanyName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label text-light">รายละเอียดเกี่ยวกับค่ายเกม</label>
                    <textarea asp-for="Description" rows="4" class="form-control"
                        style="background: #0f3460; border: 1px solid #e9456055; color: #fff;"
                        placeholder="บอกเล่าเกี่ยวกับค่ายเกมของคุณ ผลงานที่ผ่านมา แนวเกมที่ทำ"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ContactInfo" class="form-label text-light">ช่องทางติดต่อ</label>
                    <input asp-for="ContactInfo" class="form-control"
                        style="background: #0f3460; border: 1px solid #e9456055; color: #fff;" placeholder="อีเมล, เบอร์โทร, หรือ Social Media" />
                    <span asp-validation-for="ContactInfo" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="LogoImage" class="form-label text-light">โลโก้ค่ายเกม (ไม่บังคับ)</label>
                    <input asp-for="LogoImage" type="file" class="form-control"
                        style="background: #0f3460; border: 1px solid #e9456055; color: #fff;" accept="image/*" />
                </div>

                <button type="submit" class="btn fw-bold w-100 py-2" style="background: #27ae60; color: #fff;">
                    📩 ส่งคำขอสมัคร
                </button>
            </form>
        </div>
    </div>
</div>