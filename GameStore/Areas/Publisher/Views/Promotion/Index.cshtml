@model List<GameStore.Models.DB.Promotion>

@{
    ViewData["Title"] = "โปรโมชั่น";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <p class="section-title mb-0">🏷️ โปรโมชั่นของฉัน</p>
    <a asp-action="Create" class="btn btn-accent">➕ สร้างโปรโมชั่นใหม่</a>
</div>

<!-- สถิติ -->
<div class="row mb-4">
    <div class="col-md-4 mb-3">
        <div class="stat-card text-center">
            <p class="text-secondary mb-1" style="font-size: 12px;">โปรโมชั่นทั้งหมด</p>
            <p class="fw-bold mb-0" style="font-size: 28px; color: #e94560;">@Model.Count</p>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="stat-card text-center">
            <p class="text-secondary mb-1" style="font-size: 12px;">กำลังใช้งาน</p>
            <p class="fw-bold mb-0" style="font-size: 28px; color: #27ae60;">@Model.Count(p => p.IsActive == true)</p>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="stat-card text-center">
            <p class="text-secondary mb-1" style="font-size: 12px;">สิ้นสุดแล้ว</p>
            <p class="fw-bold mb-0" style="font-size: 28px; color: #888;">@Model.Count(p => p.IsActive != true)</p>
        </div>
    </div>
</div>

<!-- ตาราง -->
<div class="rounded-3" style="background: #16213e; border: 1px solid #e9456022; overflow: hidden;">
    <table class="table table-dark mb-0 table-dark-custom">
        <thead>
            <tr>
                <th>โปรโมชั่น</th>
                <th>เกม</th>
                <th>ประเภท</th>
                <th>ส่วนลด</th>
                <th>ระยะเวลา</th>
                <th>สถานะ</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var promo in Model)
            {
                <tr>
                    <td class="fw-bold text-light">@promo.Title</td>
                    <td class="text-secondary">@(promo.Game?.Title ?? "-")</td>
                    <td>
                        @switch (promo.Type)
                        {
                            case "FestivalSale":
                                <span class="badge" style="background: #e94560;">ลดเทศกาล</span>
                                break;
                            case "FreeGame":
                                <span class="badge" style="background: #27ae60;">แจกฟรี</span>
                                break;
                            case "TrialDiscount":
                                <span class="badge" style="background: #3498db;">ทดลองเล่น</span>
                                break;
                            case "SeriesDiscount":
                                <span class="badge" style="background: #f39c12;">ลด Series</span>
                                break;
                            default:
                                <span class="badge" style="background: #888;">@promo.Type</span>
                                break;
                        }
                    </td>
                    <td style="color: #e94560; font-weight: bold;">-@promo.DiscountPercent%</td>
                    <td style="font-size: 13px;">
                        <span class="text-secondary">@promo.StartDate.ToString("dd MMM")</span>
                        <span class="text-secondary"> → </span>
                        <span class="text-light">@promo.EndDate.ToString("dd MMM yyyy")</span>
                    </td>
                    <td>
                        @if (promo.IsActive == true && promo.EndDate >= DateTime.Now)
                        {
                            <span class="badge badge-approved">กำลังใช้งาน</span>
                        }
                        else
                        {
                            <span class="badge" style="background: #888;">สิ้นสุดแล้ว</span>
                        }
                    </td>
                    <td>
                        <form asp-action="Delete" method="post" data-confirm="ลบโปรโมชั่น '@promo.Title' ใช่มั้ย?">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@promo.PromotionId" />
                            <button type="submit" class="btn btn-sm" style="border: 1px solid #e74c3c; color: #e74c3c;">🗑️</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
