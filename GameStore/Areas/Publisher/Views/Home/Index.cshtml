@{
    ViewData["Title"] = "Dashboard";
}

<!-- Stats Cards -->
<div class="row mb-4">
    <div class="col-md-2 mb-3">
        <div class="stat-card text-center">
            <p class="text-secondary mb-1" style="font-size: 12px;">เกมทั้งหมด</p>
            <p class="fw-bold mb-0" style="font-size: 28px; color: #e94560;">@ViewBag.TotalGames</p>
        </div>
    </div>
    <div class="col-md-2 mb-3">
        <div class="stat-card text-center">
            <p class="text-secondary mb-1" style="font-size: 12px;">ขายแล้ว</p>
            <p class="fw-bold mb-0" style="font-size: 28px; color: #27ae60;">@ViewBag.TotalSold.ToString("N0")</p>
        </div>
    </div>
    <div class="col-md-2 mb-3">
        <div class="stat-card text-center">
            <p class="text-secondary mb-1" style="font-size: 12px;">รายได้ (฿)</p>
            <p class="fw-bold mb-0" style="font-size: 28px; color: #f39c12;">@ViewBag.TotalRevenue.ToString("N0")</p>
        </div>
    </div>
    <div class="col-md-2 mb-3">
        <div class="stat-card text-center">
            <p class="text-secondary mb-1" style="font-size: 12px;">คะแนนเฉลี่ย</p>
            <p class="fw-bold mb-0" style="font-size: 28px; color: #f1c40f;">⭐ @ViewBag.AverageRating</p>
        </div>
    </div>
    <div class="col-md-2 mb-3">
        <div class="stat-card text-center">
            <p class="text-secondary mb-1" style="font-size: 12px;">รออนุมัติ</p>
            <p class="fw-bold mb-0" style="font-size: 28px; color: #f39c12;">@ViewBag.PendingGames</p>
        </div>
    </div>
    <div class="col-md-2 mb-3">
        <div class="stat-card text-center">
            <p class="text-secondary mb-1" style="font-size: 12px;">โปรโมชั่น</p>
            <p class="fw-bold mb-0" style="font-size: 28px; color: #3498db;">@ViewBag.ActivePromotions</p>
        </div>
    </div>
</div>

<!-- เกมขายดี -->
<p class="section-title">🔥 เกมขายดี</p>
<div class="rounded-3" style="background: #16213e; border: 1px solid #e9456022; overflow: hidden;">
    <table class="table table-dark mb-0 table-dark-custom">
        <thead>
            <tr>
                <th>เกม</th>
                <th>หมวดหมู่</th>
                <th>ราคา</th>
                <th>ขายแล้ว</th>
                <th>คะแนน</th>
                <th>สถานะ</th>
            </tr>
        </thead>
        <tbody>
            @if (ViewBag.TopGames != null)
            {
                foreach (var game in ViewBag.TopGames)
                {
                    <tr>
                        <td class="fw-bold text-light">@game.Title</td>
                        <td class="text-secondary">@(game.Genre ?? "-")</td>
                        <td style="color: #e94560;">
                            @(game.IsFree == true ? "ฟรี" : "฿" + game.BasePrice.ToString("N0"))
                        </td>
                        <td>@((game.SoldCount ?? 0).ToString("N0"))</td>
                        <td style="color: #f1c40f;">
                            @(game.Rating > 0 ? "⭐ " + game.Rating?.ToString("F1") : "-")
                        </td>
                        <td>
                            @if (game.IsApproved == true)
                            {
                                <span class="badge badge-approved">อนุมัติแล้ว</span>
                            }
                            else
                            {
                                <span class="badge badge-pending">รออนุมัติ</span>
                            }
                        </td>
                    </tr>
                }
            }
            @if (ViewBag.TopGames == null || ViewBag.TopGames.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-secondary py-3">ยังไม่มีเกม</td></tr>
            }
        </tbody>
    </table>
</div>

<!-- คำสั่งซื้อล่าสุด -->
<p class="section-title mt-4">📋 คำสั่งซื้อล่าสุด</p>
<div class="rounded-3" style="background: #16213e; border: 1px solid #e9456022; overflow: hidden;">
    @if (ViewBag.RecentOrders != null && ViewBag.RecentOrders.Count > 0)
    {
        <table class="table table-dark mb-0 table-dark-custom">
            <thead>
                <tr>
                    <th>เกม</th>
                    <th>ผู้ซื้อ</th>
                    <th>ราคา</th>
                    <th>วันที่</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var oi in ViewBag.RecentOrders)
                {
                    <tr>
                        <td class="fw-bold text-light">@oi.Game.Title</td>
                        <td class="text-secondary">@(oi.Order.Customer.DisplayName ?? oi.Order.Customer.Username)</td>
                        <td style="color: #27ae60;">฿@oi.NetPrice.ToString("N0")</td>
                        <td class="text-secondary" style="font-size: 13px;">@(oi.Order.CreatedAt?.ToString("dd MMM yyyy") ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="p-4 text-center text-secondary">ยังไม่มีคำสั่งซื้อ</div>
    }
</div>