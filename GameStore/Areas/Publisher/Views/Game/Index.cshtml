@model List<GameStore.Models.DB.Game>

@{
    ViewData["Title"] = "จัดการเกม";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <p class="section-title mb-0">🎮 เกมของฉัน</p>
    <a asp-action="Create" class="btn btn-accent">➕ เพิ่มเกมใหม่</a>
</div>

<div class="rounded-3" style="background: #16213e; border: 1px solid #e9456022; overflow: hidden;">
    <table class="table table-dark mb-0 table-dark-custom">
        <thead>
            <tr>
                <th>เกม</th>
                <th>หมวดหมู่</th>
                <th>ราคา</th>
                <th>ขายแล้ว</th>
                <th>คะแนน</th>
                <th>สถานะ</th>
                <th>จัดการ</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var game in Model)
            {
                <tr>
                    <td>
                        <div class="d-flex align-items-center">
                            <img src="@game.CoverImage" alt="@game.Title" class="rounded me-2" style="width: 60px; height: 35px; object-fit: cover;" />
                            <span class="fw-bold text-light">@game.Title</span>
                        </div>
                    </td>
                    <td class="text-secondary">@game.Genre</td>
                    <td>
                        @if (game.IsFree == true)
                        {
                            <span style="color: #27ae60;">ฟรี</span>
                        }
                        else
                        {
                            <span style="color: #e94560;">฿@game.BasePrice.ToString("N0")</span>
                        }
                        @if (game.DiscountPercent > 0)
                        {
                            <span class="badge badge-rejected ms-1" style="font-size: 10px;">-@game.DiscountPercent%</span>
                        }
                    </td>
                    <td>@(game.SoldCount?.ToString("N0") ?? "0")</td>
                    <td style="color: #f1c40f;">
                        @if (game.Rating > 0)
                        {
                            <span>⭐ @game.Rating</span>
                        }
                        else
                        {
                            <span class="text-secondary">-</span>
                        }
                    </td>
                    <td>
                        @if (game.IsApproved == true)
                        {
                            <span class="badge badge-approved">อนุมัติแล้ว</span>
                        }
                        else
                        {
                            <span class="badge badge-pending">รออนุมัติ</span>
                        }
                        @if (game.HasTrial == true)
                        {
                            <span class="badge" style="background: #3498db; font-size: 10px;">Trial @game.TrialHours ชม.</span>
                        }
                    </td>
                    <td>
                        <div class="d-flex gap-1">
                            <a asp-action="Edit" asp-route-id="@game.GameId" class="btn btn-sm" style="border: 1px solid #3498db; color: #3498db;">✏️</a>
                            <a asp-action="Delete" asp-route-id="@game.GameId" class="btn btn-sm" style="border: 1px solid #e74c3c; color: #e74c3c;">🗑️</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
