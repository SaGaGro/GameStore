<table class="table">
    <thead>
        <tr>
            <th>UserId</th>
            <th>Name</th>
            <th>Lastname</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.UserId</td>
                <td>@user.Name</td>
                <td>@user.Lastname</td>
                <td><a asp-route-UID="@user.UserId" asp-action="Lab10" asp-controller="Account">Edit</a>
                <a asp-route-UID="@user.UserId" asp-action="Lab10Remove" asp-controller="Account">Delete</a></td>
            </tr>
        }
    </tbody>Ho
</table>
