@using GameStore.Models.DB
@using Microsoft.AspNetCore.Http.Features
@model IEnumerable<GameStore.Models.DB.User>


<div>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Uid</th>
                <th>Username</th>
                <th>PasswordHash</th>
                <th>Email</th>
                <th>RoleId</th>
                <th>WalletPoints</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model){
                <tr>
                    <td>@item.UserId</td>
                    <td>@item.Username</td>
                    <td>@item.PasswordHash</td>
                    <td>@item.Email</td>
                    <td>@item.RoleId</td>
                    <td>@item.WalletPoints</td>
                </tr>
            }
        </tbody>
    </table>
</div>